PORT=5050
NODE_ENV=development
PUBLIC_API_URL=http://localhost:5050
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
# Keep false on public deployments. This enables videos and any upload above
# 6 MiB only for a trusted pilot with provider-side budget/rate controls.
ENABLE_BOOKING_MEDIA_PILOT_UPLOADS=false
IDEMPOTENCY_TTL_MS=86400000
APP_INITIALIZE_CACHE_TTL_MS=60000
LOG_LEVEL=info

SUPABASE_URL=https://your-project.supabase.co
# Preferred modern public key. Safe for clients, but keep it in environment configuration.
SUPABASE_PUBLISHABLE_KEY=
# Legacy public-key fallback.
SUPABASE_ANON_KEY=
# Preferred modern backend key. Never expose this to the frontend.
SUPABASE_SECRET_KEY=
# Legacy fallback for existing Supabase projects.
SUPABASE_SERVICE_ROLE_KEY=

AUTH_EMAIL_AUTO_CONFIRM=false
OAUTH_SESSION_EMAIL_DOMAIN=auth.shc.invalid
KAKAO_REST_API_KEY=
KAKAO_ADMIN_KEY=
APPLE_CLIENT_IDS=com.example.shc
